# Supabase Project Settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase Postgres connection string (use the pooler URL on Vercel)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Guest mode is optional for local demos only. Production should use Supabase Auth.
VITE_GUEST_MODE=false
ALLOW_GUEST_AUTH=false
